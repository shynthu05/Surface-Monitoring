# Secret Key for Flask Session Encryption
SECRET_KEY=cyber-soc-secret-key-super-secure-change-in-prod-2026

# Database URI (defaults to SQLite in database/surface_monitoring.db)
DATABASE_URL=sqlite:///database/surface_monitoring.db

# Path to Nmap executable (e.g., C:\Program Files (x86)\Nmap\nmap.exe on Windows, or /usr/bin/nmap on Linux)
NMAP_PATH=nmap

# National Vulnerability Database (NVD) API Key (optional, increases rate limit from 5 to 50 req/30s)
NVD_API_KEY=

# Default timeout in seconds for active scans
SCAN_DEFAULT_TIMEOUT=300

# Enable automated demo / lab target simulation when Nmap is not installed or when testing
DEMO_LAB_SIMULATION=true
